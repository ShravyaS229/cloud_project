# ====== COPY THIS FILE TO ".env" AND REPLACE EVERY VALUE WITH YOUR OWN CREDENTIALS ======

# REPLACE: Neon connection string (Neon dashboard > Connect > turn OFF "Connection pooling")
# Host must NOT contain "-pooler". Remove "&channel_binding=require" if present.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=verify-full&connect_timeout=30"

# REPLACE: any long random text
JWT_SECRET="replace-with-a-long-random-string"

PORT=5000

# REPLACE: Cloudinary dashboard > Cloud name / API Key / API Secret
CLOUDINARY_CLOUD_NAME="replace-with-your-cloud-name"
CLOUDINARY_API_KEY="replace-with-your-api-key"
CLOUDINARY_API_SECRET="replace-with-your-api-secret"

# REPLACE: your frontend address. Local: http://localhost:5173
# After deploying: your Vercel URL, e.g. https://campus-marketplace.vercel.app (no trailing slash)
CLIENT_URL="http://localhost:5173"
